{
  "name": "service-base",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build:api": "nest build api",
    "build:messaging": "nest build messaging",
    "build:delay": "nest build delay",
    "build:web": "nest build web",
    "build:repl": "nest build repl",
    "format": "prettier --write \"apps/**/*.ts\"",
    "start:dev": "docker-compose -f docker-compose.yml up",
    "start:dev:rebuild": "docker-compose -f docker-compose.yml up --build -V --remove-orphans",
    "start:dev:storage_only": "docker-compose -f docker-compose.storage.yml up --build -V",
    "start:api:dev": "nest start api --watch --debug 0.0.0.0:9229",
    "start:api:prod": "node ./dist/apps/api/main.js",
    "start:repl:dev": "REDIS_URL='127.0.0.1:6380' nest start repl",
    "start:repl:prod": "node ./dist/apps/api/repl.js",
    "start:messaging:dev": "nest start messaging --watch --debug 0.0.0.0:9229",
    "start:messaging:prod": "node ./dist/apps/messaging/main.js",
    "start:delay:dev": "nest start delay --watch --debug 0.0.0.0:9229",
    "start:delay:prod": "node ./dist/apps/delay/main.js",
    "start:web:dev": "nest start web --watch --debug 0.0.0.0:9229",
    "start:web:prod": "node ./dist/apps/web/main.js",
    "redis:cli": "docker-compose -f docker-compose.yml run redis redis-cli -h redis -p 6380",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:api": "jest --config ./apps/api/test/jest-e2e.json",
    "test:e2e:messaging": "jest --config ./apps/messaging/test/jest-e2e.json",
    "test:e2e:delay": "jest --config ./apps/delay/test/jest-e2e.json",
    "typeorm": "ts-node ./node_modules/typeorm/cli"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.194.0",
    "@golevelup/nestjs-discovery": "^3.0.0",
    "@nestjs/axios": "^1.0.1",
    "@nestjs/cache-manager": "^1.0.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.4.0",
    "@nestjs/event-emitter": "^1.3.1",
    "@nestjs/graphql": "^11.0.5",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/typeorm": "^9.0.1",
    "@sendgrid/client": "^7.7.0",
    "@sendgrid/mail": "^7.7.0",
    "auth0": "^3.1.2",
    "cassandra-driver": "^4.6.4",
    "cloudevents": "^6.0.3",
    "dd-trace": "^4.20.0",
    "express": "^4.18.2",
    "graphql": "^16.6.0",
    "hbs": "^4.2.0",
    "hot-shots": "^10.0.0",
    "ioredis": "^5.2.4",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^0.3.4",
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.4.0",
    "@types/express": "^4.17.13",
    "@types/jest": "28.1.4",
    "@types/node": "^16.0.0",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "aws-sdk-client-mock": "^2.0.0",
    "aws-sdk-client-mock-jest": "^2.0.0",
    "better-sqlite3": "^7.6.2",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "28.1.2",
    "prettier": "^2.3.2",
    "prettier-plugin-organize-imports": "^3.2.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.5",
    "ts-json-schema-generator": "^1.2.0",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.0.0",
    "typeorm": "^0.3.11",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^@lib/shared-config(|/.*)$": "<rootDir>/libs/shared-config/src/$1",
      "^@lib/events(|/.*)$": "<rootDir>/libs/events/src/$1",
      "^@lib/caching(|/.*)$": "<rootDir>/libs/caching/src/$1",
      "^@config(|/.*)$": "<rootDir>/configuration/$1"
    },
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ]
  }
}
